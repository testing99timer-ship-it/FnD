{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "billing-sync-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/sync/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Tenant-Id",
            "Set": "{RequestHeader:X-Tenant-Id}"
          }
        ]
      },
      "ai-reporting-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      },
      "dashboard-reporting-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "billing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5253/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5253/"
          }
        }
      }
    }
  }
}